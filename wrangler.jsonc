{
  // Independent Worker for the WQ's Proxy VPN product site.
  // Static assets only: no Worker script, no bindings, no Durable Objects, no secrets.
  // It must never be deployed under the personal-site Worker name ("wqzachery").
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wq-proxy-vpn-site",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": true,
  "send_metrics": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  // Custom domain approved by the owner on 2026-10-25. Cloudflare creates the DNS record and certificate.
  "routes": [{ "pattern": "vpn.wqzachery.dpdns.org", "custom_domain": true }]
}
